# $Revision$, $Source$, $Date$

use strict;
use warnings;
use version;
use Scalar::Util;
use List::Util;
#use List::MoreUtils;
use Getopt::Long;
use Pod::Usage;
use Data::Dumper qw/Dumper/;
use English qw/ -no_match_vars /;
use FindBin qw/$Bin/;
use Path::Tiny;

our $VERSION = 0.001;
my ($name)   = $PROGRAM_NAME =~ m{^.*/(.*?)$}mxs;

my %option = (
    out     => undef,
    verbose => 0,
    man     => 0,
    help    => 0,
    VERSION => 0,
);

main();
exit 0;

sub main {
    if (!grep /[-]/, @ARGV) {
        $option{added}    = 1;
        $option{modified} = 1;
    }

    Getopt::Long::Configure('bundling');
    GetOptions(
        \%option,
        'added|a',
        'modified|m',
        'unknown|u',
        'verbose|v+',
        'man',
        'help',
        'VERSION!',
    ) or pod2usage(2);

    if ( $option{'VERSION'} ) {
        print "$name Version = $VERSION\n";
        exit 1;
    }
    elsif ( $option{'man'} ) {
        pod2usage( -verbose => 2 );
    }
    elsif ( $option{'help'} ) {
        pod2usage( -verbose => 1 );
    }

    # do stuff here
    my @args = join ' ', map {qq{"$_"}} @ARGV;
    my @files = `git status --porcelain @args`;

    for my $file (@files) {
        chomp $file;
        if ( $file =~ m{^AM?\s+(.*)$}mxs ) {
            print "$1\n" if $option{added};
        }
        elsif ( $file =~ m{^\s*M\s+(.*)$}mxs ) {
            print "$1\n" if $option{modified};
        }
        elsif ( $file =~ m{^\?\?\s+(.*)$}mxs ) {
            print "$1\n" if $option{unknown};
        }
    }

    return;
}

__DATA__

=head1 NAME

git-status-files - show just the files shown by git status with ability to filter by added, modified, or unknown files.

=head1 VERSION

This documentation refers to git-status-files version

=head1 SYNOPSIS

   git-status-files [-a|--added] [-m|--modified] [-u|--unknown] [--verbose] [--version] [--help] [--man]

 OPTIONS:
  -a --added         Show added files (default)
  -m --modified      Show modified files (default)
  -u --unknown       Show unknown files (off by default)

  -v --verbose       Show more detailed option
     --version       Prints the version information
     --help          Prints this help information
     --man           Prints the full documentation for git-status-files

=head1 DESCRIPTION

Quick script to show just the files shown by git status with ability to filter by added, modified, or unknown files.

